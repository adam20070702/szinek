<Window x:Class="szinek.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:szinek"
        mc:Ignorable="d"
        Title="Színek" Height="400" Width="500">
    <Grid>
        <DockPanel>
            <Menu  DockPanel.Dock="Top">
                    <MenuItem Header="Fájl">
                    <MenuItem Header="Megnyitás" />
                    <MenuItem Header="Mentés"/>
                    <Separator></Separator>
                <MenuItem Header="Kilépés" Click="kilepes"/>
            </MenuItem>
            <MenuItem Header="Nézet">
                <MenuItem Header="Teljes képernyő"></MenuItem>
                <MenuItem Header="Nagyítás">
                    <MenuItem Header="100%"></MenuItem>
                    <MenuItem Header="200%" Click="dupla"></MenuItem>
                    <MenuItem Header="50%" Click="fele"></MenuItem>
                </MenuItem>
                <MenuItem Header="Szerkesztés">
                    <MenuItem Header="Törlés"></MenuItem>
                </MenuItem>
            </MenuItem>
            </Menu>

            <StackPanel DockPanel.Dock="Top" Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    <Slider x:Name="slider" Width="100" VerticalAlignment="Center" Value="40" Margin="5" Minimum="0" Maximum="100"></Slider>
                    <Label Margin="10" Content="Szín"></Label>
                    <ComboBox x:Name="combobox" Width="100" SelectedIndex="0" Margin="10">
                        <ComboBoxItem>Piros</ComboBoxItem>
                        <ComboBoxItem>Zöld</ComboBoxItem>
                        <ComboBoxItem>Kék</ComboBoxItem>
                    </ComboBox>
                    <Button Content="Hozzáadás" Width="100" Margin="10" Click="hozzaadas"></Button>
                </StackPanel>
                <DataGrid x:Name="datagrid" MinHeight="200"></DataGrid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Törlés" Width="100" Margin="5" Click="torles"></Button>
                    <Button Click="kilepes" Content="Kilépés" Width="100" Margin="5"></Button>
                </StackPanel>
            </StackPanel>
            
        </DockPanel>
    </Grid>
</Window>
